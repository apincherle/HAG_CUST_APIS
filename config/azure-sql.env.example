# Azure SQL — copy to config/azure-sql.env (gitignored) for local prod-profile runs.
# For deployed Container Apps, set the same values in Key Vault (dashed secret names below).
#
#   cp config/azure-sql.env.example config/azure-sql.env
#   # edit config/azure-sql.env — never commit it
#
# Key Vault secret names (azure-pipelines.yml Deploy stage):
#   azure-sql-server, azure-sql-database, azure-sql-username, azure-sql-password, azure-sql-port

SPRING_PROFILES_ACTIVE=prod

AZURE_SQL_SERVER=hags.database.windows.net
AZURE_SQL_DATABASE=hags_customer
AZURE_SQL_USERNAME=adminhags@hags
AZURE_SQL_PASSWORD=your-password-here
AZURE_SQL_PORT=1433

# Optional: JDBC URL (app builds this from the vars above; for DBeaver use Host + Database instead)
# jdbc:sqlserver://hags.database.windows.net:1433;database=hags_customer;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30;
